# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# stateless | stateful | auto (framework default: auto, which resolves to stateful).
# src/index.ts declares stateless via createApp({ sessionMode }): no tool or
# resource here calls ctx.requestInput, so nothing needs a durable session. This
# line and the Dockerfile's ENV restate it — a value other than stateless set
# here overrides the declaration.
MCP_SESSION_MODE=stateless
# The three resumability knobs below apply to STATEFUL serving only. They have no
# effect while MCP_SESSION_MODE=stateless, nor on the session-less 2026-07-28 era.
# MCP_HTTP_RESUMABILITY=false            # SSE replay of a dropped stream. Kill switch only (default: true)
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Events retained per session, oldest evicted first (default: 512)
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable (default: 300000)

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables (default: 10)
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000  # Window the threshold is counted over, ms (default: 60000)
# LOG_TOOL_FAILURE_PAYLOADS=false   # Opt-in failed-call input/result logs; key-name redaction only
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384 # Per-field serialized payload cap (bytes)

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # Base for traces + metrics (/v1/traces, /v1/metrics); never enables logs
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Optional full traces endpoint override
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Optional full metrics endpoint override
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Explicit opt-in full logs endpoint; requires OTLP log peers

# ── DataCanvas (analytical SQL spill for chembl_get_bioactivities) ─────
# Set to duckdb to enable the bioactivity spill + chembl_dataframe_* SQL path.
# When none, chembl_get_bioactivities still inlines a preview but never spills,
# and the chembl_dataframe_* tools return a "canvas disabled" error.
# CANVAS_PROVIDER_TYPE=duckdb        # none | duckdb (default: none)
# CANVAS_TEMP_PATH=                 # Parent for a private scratch directory; defaults to the OS temp directory

# ── ChEMBL upstream (keyless — no API key) ────────────────────────────
# CHEMBL_API_BASE_URL=https://www.ebi.ac.uk/chembl/api/data  # Override for a private mirror / pinned host
# CHEMBL_REQUEST_TIMEOUT_MS=30000    # Per-request timeout for upstream fetches (default: 30000)
# CHEMBL_MAX_PAGE_SIZE=1000          # ChEMBL per-page cap when streaming activity pages for spill (max 1000)
# CHEMBL_DEFAULT_LIMIT=25            # Default limit applied when callers omit it (default: 25)
# CHEMBL_MAX_SPILL_ROWS=50000        # Ceiling on rows chembl_get_bioactivities stages to a canvas table,
                                     # and so on the upstream page drain behind it. Over the cap the
                                     # response reports truncated: true (default: 50000)
# CHEMBL_DATAFRAME_DROP_ENABLED=false # Register the opt-in chembl_dataframe_drop tool (default: false)
