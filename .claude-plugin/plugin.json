{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "chembl-mcp-server",
  "version": "0.3.1",
  "description": "Link compounds to protein targets, rank bioactivity, and look up drug mechanisms and indications.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/chembl-mcp-server#readme",
  "repository": "https://github.com/cyanheads/chembl-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "chembl",
    "drug-discovery",
    "bioactivity",
    "cheminformatics"
  ],
  "mcpServers": {
    "chembl-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/chembl-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
